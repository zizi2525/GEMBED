TMDB_API_KEY=your_tmdb_api_key
# Optional: JSON array for multi-key rotation
# TMDB_API_KEYS=["key1","key2"]
# Optional: server port (defaults to 8787)
# API_PORT=8787
# Per-provider fetch timeout in ms (defaults to 20000)
PROVIDER_TIMEOUT_MS=20000
# Disable in-memory/file provider caches
DISABLE_CACHE=false
# Provider Enable Flags (default true)
ENABLE_VIDSRC_PROVIDER=true
ENABLE_MEGAPLAY_PROVIDER=true
# App Secret for Stream URL Encryption & Token Authentication
# APP_SECRET=your_32_byte_hex_secret

# Upstream Extractor Rotating Proxy for Scrapers (Webshare, etc.)
# Bypasses Cloudflare WAF, IP bans, and rate limits for upstream scraper metadata & tokens
# EXTRACTOR_PROXY_URL=http://username:password@p.webshare.io:80
# EXTRACTOR_PROXY_PROVIDERS=vidzy,vixsrc,netmirror
# EXTRACTOR_PROXY_VIXSRC_ENABLED=true
# EXTRACTOR_PROXY_VIDSRC_ENABLED=false
# EXTRACTOR_PROXY_MOVIEBOX_ENABLED=false

ENABLE_PROXY=true

# Stream Proxy Per-Provider Controls (matches gibox web app)
# Providers that DO NOT need a proxy by default (CORS enabled / direct playback):
# - vixsrc: false (includes Access-Control-Allow-Origin: * on master and segments)
# - vidzy: false (direct HLS works without proxy)
# - netmirror: false (MovieBox direct MP4s play straight in native HTML5 video)
#
# Providers that REQUIRE a proxy:
# - vidy: true (enforces strict Referer / Origin checks and lacks CORS)
# - vidsrc: true (Aura; enforces strict Referer checks on HLS playlists and segments)
STREAM_PROXY_VIXSRC_ENABLED=false
STREAM_PROXY_VIDZY_ENABLED=false
STREAM_PROXY_NETMIRROR_ENABLED=false
STREAM_PROXY_VIDY_ENABLED=true
STREAM_PROXY_MOVIEBOX_ENABLED=true
STREAM_PROXY_CASTLE_ENABLED=false
STREAM_PROXY_VIDSRC_ENABLED=true
STREAM_PROXY_MEGAPLAY_ENABLED=true

# Optional: Cloudflare Worker Stream Proxy (offloads 100% video bandwidth to Cloudflare Edge)
# Deploy cloudflare-proxy/worker.js to your Cloudflare account and paste the URL below:
# Example: CLOUDFLARE_STREAM_PROXY_URL=https://embed-gibox-stream-proxy.yourname.workers.dev
CLOUDFLARE_STREAM_PROXY_URL=https://black-fire-3fdb.zzdqqsd.workers.dev

# Force specific providers to route through proxy regardless of default:
# Examples: STREAM_PROXY_FORCE=vidzy,vixsrc
STREAM_PROXY_FORCE=

# Global override: set to true to force all streams through proxy, or false to force direct
# STREAM_PROXY_ALL_ENABLED=

# Allowed Origins for backend API & stream proxy (comma-separated, supports wildcards like * or *.domain.com or localhost:*)
# Examples:
#   Allow everything: ALLOWED_ORIGINS=*
#   Allow specific sites: ALLOWED_ORIGINS=http://localhost:3000,https://mysite.com,https://*.mysite.com
ALLOWED_ORIGINS=*

# Set to true to strictly block requests without Origin/Referer header
BLOCK_NO_ORIGIN=false

# ── Admin Dashboard Security ────────────────────────────────────────────────
# For production security, the admin dashboard is disabled and hidden by default.
# The root route (/) returns a clean operational JSON status, and all admin/config/metrics
# routes return 404 to avoid leaking your extractor stack or offering a login target.
#
# To enable the admin dashboard:
# ENABLE_ADMIN_DASHBOARD=true
#
# To protect the dashboard with a secret key gate (requires visiting /?key=YOUR_SECRET):
# ADMIN_SECRET_KEY=your_secret_admin_key_here
ENABLE_ADMIN_DASHBOARD=false
ADMIN_SECRET_KEY=

# ── Cloudflare Turnstile Bot Protection ─────────────────────────────────────
# Turnstile site key & secret key live on the frontend. Set TURNSTILE_ENABLED=true
# here to require the frontend's APP_SECRET-signed x-turnstile-proof on stream APIs.
TURNSTILE_ENABLED=false
