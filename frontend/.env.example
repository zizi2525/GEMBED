# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill it in:  cp .env.example .env
# Only TMDB_API_KEY and APP_SECRET are required. Everything else is optional.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — your own TMDB (The Movie Database) API key.
# Get one free at https://www.themoviedb.org/settings/api  (v3 auth "API Key")
TMDB_API_KEY=

# REQUIRED — a long random secret used to sign the internal stream-proxy URLs
# so your server can't be abused as an open proxy. Generate one with:
#   openssl rand -hex 32
APP_SECRET=

# Port the server listens on (default 3000).
PORT=3000

# ── Branding (safe to expose to the browser) ────────────────────────────────
# Visible player / brand name (window title + metadata).
PLAYER_NAME=Vidsuper
# Short tagline shown alongside the name in the browser tab.
PLAYER_TAGLINE=Video streaming player
# Default accent colour (hex, with or without #). Override per-embed with ?color=
ACCENT_COLOR=ef4444
# Brand link used by the homepage header and footer (optional).
PLAYER_URL=
# Custom promo text shown in player (optional).
PROMO_TEXT=
# Logo path served from /public. To rebrand, replace public/logo.svg (keep the
# name) OR drop a new file in public/ and point this at it, e.g. /brand.png
LOGO_SRC=/logo.svg

# ── Server display names — optional custom names ─────────────────────────────
# The player shows these in its "Server" menu.
# SERVER_1_NAME=Server 1
# SERVER_2_NAME=Server 2
# SERVER_3_NAME=Server 3

# ── Subtitles & Audio ────────────────────────────────────────────────────────
SUBTITLES_ENABLED=true
NEXT_PUBLIC_API_URLS=
# ── Devtools / debugger protection ──────────────────────────────────────────
# true  = always on (including `next dev`)
# false = always off (recommended while developing locally)
# unset = on for production builds, off in `next dev`
# Must be NEXT_PUBLIC_* because it is read in the browser. Leave it commented
# out to keep the secure production default; uncomment for local development.
# NEXT_PUBLIC_DEBUG_PROTECTION=false
# ── Skip intro/credits ───────────────────────────────────────────────────────
# Skip-intro works out of the box (no key needed).
SEGMENTS_API_KEY=

# ── Cloudflare Turnstile Bot Protection (invisible mode) ─────────────────────
# Leave empty to disable in local dev, or use Cloudflare Turnstile keys:
# (Always-pass test keys: site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
